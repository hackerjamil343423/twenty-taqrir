generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sijil {
  id           String   @id @default(cuid())
  title        String
  templateSlug String
  token        String   @unique @default(cuid())
  usageCount   Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}
